Notebook[{

Cell[CellGroupData[{
Cell["Nonlinear Differential Equations", "Subtitle",
 TextAlignment->Center,
 TextJustification->0,ExpressionUUID->"9622b1c2-5218-461d-aa82-1d8ba08b3feb"],

Cell["\<\
In this notebook, we solve nonlinear differential equations, looking at the \
time dependence, phase space plots, Poincare sections, and the power spectrum.

The notebook starts with the Duffing equation.  Your job is to modify it to \
the damped, driven pendulum, then to reproduce and extend the results from \
session 8 (which used diffeq_pendulum.cpp).\
\>", "Text",ExpressionUUID->"0f8d1bf9-0551-40fc-a1c1-1cdaf8acd746"],

Cell[CellGroupData[{

Cell["Define the Differential Equation", "Section",ExpressionUUID->"17661850-6212-4fe0-93b6-6b10937da593"],

Cell["\<\
Name the equation \"diffeq\".  Note the \"==\" in defining the equation.  \
\>", "Text",ExpressionUUID->"e3d34740-169f-418e-a3b3-479cf86a3c8a"],

Cell[BoxData[
 RowBox[{"diffeq", " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
    RowBox[{"2", " ", "\[Gamma]", " ", 
     RowBox[{
      RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
    RowBox[{"\[Alpha]", "  ", 
     RowBox[{"x", "[", "t", "]"}]}], "+", 
    RowBox[{"\[Beta]", " ", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "^", "3"}]}]}], "\[Equal]", 
   RowBox[{"fext", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"\[Omega]ext", " ", "t"}], "]"}], " "}]}]}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"7e345c58-9f3f-42ac-a031-eb8b9c700e97"],

Cell["Choose among the parameters:", "Text",ExpressionUUID->"c427e8cc-88e1-4fe3-80a6-58cb13ce97bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p1", " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "=", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"\[Beta]", "=", "1"}], ",", 
     RowBox[{"\[Omega]ext", "=", "1"}], ",", " ", 
     RowBox[{"\[Gamma]", "=", "0.25"}], ",", 
     RowBox[{"fext", "=", "0.34875"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"f331a334-922b-43a3-8ee8-bd0d47d8bd75"],

Cell[CellGroupData[{

Cell[BoxData["p1"], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"db6bc7eb-b9b7-407c-ac8a-2c358297dbb6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "1"}], ",", "1", ",", "1", ",", "0.25`", ",", "0.34875`"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.982236383162826*^9, 3.982236567028583*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"1e47333e-a063-4336-8782-d385a213c1a9"]
}, Open  ]],

Cell["Choose among the initial conditions:", "Text",ExpressionUUID->"196eb9e1-0ee2-42c7-a904-5628dc7bd2c3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ic1", " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x0", "=", "1"}], ",", 
     RowBox[{"v0", "=", "0."}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"1f132f21-55cf-4b35-83f3-4a3dba2c1883"],

Cell[CellGroupData[{

Cell[BoxData["ic1"], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"14776fdb-766f-4ea4-a576-f474238f8d4a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "0.`"}], "}"}]], "Output",
 CellChangeTimes->{3.9822363831716957`*^9, 3.982236567031823*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"a671d637-ee0d-4762-b72c-4362859346be"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solve the Differential Equation", "Section",ExpressionUUID->"1d859ede-27a2-449e-9082-a703cbf15c5e"],

Cell["\<\
Specify the range in time over which we will solve the differential equation. \
 We won't be able to use the solution outside of this range. (I.e., we'll \
have to extend this range if we get an \"outside of range\" error later.)\
\>", "Text",ExpressionUUID->"2c807e2c-65af-4a0f-a219-cfbb99b9a428"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tmin", "=", "0"}], ";", " ", 
  RowBox[{"tmax", "=", "1000"}], ";"}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"1b6ddc99-8f96-49d3-b57c-2e29f889536f"],

Cell["\<\
Numerically solve the differential equaiton using NDSolve, specifying the \
initial conditions.  Setting MaxSteps to a large number is needed if tmax is \
large.\
\>", "Text",ExpressionUUID->"73d20d27-b7cd-47b3-b9df-ba7d0bfb50e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solution", " ", "=", " ", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"diffeq", ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "\[Equal]", "x0"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", "v0"}]}], "}"}], ",",
      "x", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
     RowBox[{"MaxSteps", "\[Rule]", "20000"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"b89d6bfa-76c4-46d4-b546-b1d37696ea12"],

Cell["\<\
NDSolve returns an \"interpolating function\", which can be evaluated later \
at any time t in tmin < t < tmax.\
\>", "Text",ExpressionUUID->"cf47e937-6155-4200-b68a-b81e507f56c1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plot the Time Dependence and Phase Space", "Section",ExpressionUUID->"081173a8-8c6c-461d-8d64-436ada77c439"],

Cell["\<\
We can just use \"Plot\" with Evaluate and the \"interpolating function\" \
defined by \"solution\".\
\>", "Text",ExpressionUUID->"137ffaa3-9856-45a6-a33b-6f42351c4848"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "/.", "solution"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"db635a25-be31-4291-9aed-2d96ce4550f9"],

Cell[BoxData[
 GraphicsBox[
  InterpretationBox[{
    TagBox[{{{}, {}, 
       TagBox[
