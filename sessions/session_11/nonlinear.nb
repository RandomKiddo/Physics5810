Cell[CellGroupData[{

Cell["Poincare Sections", "Section",ExpressionUUID->"b099baf4-bf23-4e23-aed1-5dafe3ea0a57"],

Cell["\<\
The idea of a Poincare section is to plot a point in phase space once every \
period of the external force, 2\[Pi]/(external frequency).  The resulting \
pattern gives information about the periodicity of the signal (or indicates \
chaos).  Start the plot at a large enough time t (\"tstart\") so that the \
transients have died out.\
\>", "Text",ExpressionUUID->"17d16ff9-8bd5-492f-acd5-1a9e4d5c6380"],

Cell["\<\
Set the external period and how many periods we'll consider.  Define a \
function timeperiod[i] giving the corresponding time as a function of the \
period number.\
\>", "Text",ExpressionUUID->"c9ef0d38-cf91-4d83-97fa-d5bf40f60942"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Texternal", " ", ":=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Pi", "/", "\[Omega]ext"}]}]}], ";"}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"4d1a416e-2f49-4f27-a2c5-3d6ea0b965ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tstart", " ", "=", " ", 
   RowBox[{"40", "Texternal"}]}], ";"}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"15ef7ca3-50a9-4a73-8b6d-95bc28176ac3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numperiods", " ", "=", " ", "20"}], ";"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"91ade204-7bc8-4a25-916e-874da04b1938"],

Cell[BoxData[
 RowBox[{
  RowBox[{"timeperiod", "[", "i_", "]"}], " ", ":=", " ", 
  RowBox[{"tstart", " ", "+", " ", 
   RowBox[{"i", "*", "Texternal"}]}]}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"d1e90ca7-cd21-40d1-a7ce-d7dd47798995"],

Cell["\<\
Just evaluate at the relevant points.  Flatten[expr,1] strips off a layer of \
{}'s.\
\>", "Text",ExpressionUUID->"380e48d3-da5f-4b50-8802-ee927d29deec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PoincarePts", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"timeperiod", "[", "i", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"x", "'"}], "[", 
            RowBox[{"timeperiod", "[", "i", "]"}], "]"}]}], "}"}], "/.", 
         "solution"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "numperiods"}], "}"}]}], "]"}], ",", 
     "1"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"2ebf3ba9-48c8-4d27-9a5f-ed2845879fdf"],

Cell["ListPlot plots pairs of numbers in the PlotRange.", "Text",ExpressionUUID->"0de2b06c-f0fc-4e3a-a000-cfcf297ea0ac"],

Cell[CellGroupData[{

