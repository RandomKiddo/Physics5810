Cell["\<\
The basic command is Fourier.  FourierParameters chooses a particular \
convention for defining the transform.  Abs takes the magnitude of the \
resulting complex number (which we then square).  \
\>", "Text",
 CellChangeTimes->{
  3.571333234584032*^9},ExpressionUUID->"faf55485-9300-40bc-a210-\
807e530276f5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CenteredPts", "=", 
   RowBox[{"SamplePts", "-", 
    RowBox[{"Mean", "[", "SamplePts", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transform", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"Fourier", "[", 
      RowBox[{"CenteredPts", ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}], "]"}], "^", 
    "2"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9822365592929373`*^9, 3.982236562046789*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"50e70bbe-3a35-4dd1-ade3-fd53049463be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"frequencies", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"Pi", "/", "SampleTime"}]}], ")"}], "*", "i"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "numpoints"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"73636615-d3c5-466d-9bfd-52d977b2777d"],

Cell["\<\
Transpose to make pairs of points from two separate lists of points.\
\>", "Text",ExpressionUUID->"0d58600b-387a-40fb-a32c-63ccaa1b7c01"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PlotPts", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"frequencies", ",", "transform"}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"a1dd4299-a468-48d7-b7f7-e19869314f6c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{"PlotPts", ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.1"}], ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.001`", ",", "0.1`"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"BaseStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
      RowBox[{"FontSize", "\[Rule]", "14"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"400", ",", "300"}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Style", "[", "\"\<Power Spectrum\>\"", "]"}]}], ",", 
   RowBox[{"AxesOrigin", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<freq.\>\"", ",", "\"\<power\>\""}], "}"}]}]}], 
  "]"}]], "Input",
