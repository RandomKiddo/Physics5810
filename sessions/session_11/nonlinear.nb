Cell[CellGroupData[{

Cell["Power Spectrum", "Section",ExpressionUUID->"63651021-52db-4158-81dd-7b5a4251fcd8"],

Cell["\<\
The power spectrum is found by taking a Fourier transform (FFT) of the \
signal.  We generate points at the same time intervals as in \
diffeq_pendulum.cpp.\
\>", "Text",ExpressionUUID->"2cee9d61-36bf-4f8b-b991-c53a64b2ae30"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tskip", " ", "=", " ", "100"}], ";"}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"a443c2bf-fcf8-45f6-bc1e-324f0525b2e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"time", "[", "i_", "]"}], ":=", 
  RowBox[{"tstart", "+", 
   RowBox[{"i", "*", 
    RowBox[{"Texternal", "/", "Tskip"}]}]}]}]], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"b29303a8-016b-4a8c-a567-27927f4b9de2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numpoints", " ", "=", " ", "5000"}], ";"}]], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"8ef60d22-0eed-4bf5-8ea5-493a0da4f176"],

Cell[BoxData[
 RowBox[{"SampleTime", " ", ":=", " ", 
  RowBox[{"numpoints", " ", "*", " ", 
   RowBox[{"Texternal", "/", "Tskip"}]}]}]], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"76ca2296-e92a-4816-8dad-e4ca3b39d6cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SamplePts", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"time", "[", "i", "]"}], "]"}], "/.", "solution"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "numpoints"}], "}"}]}], "]"}], ",", "1"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"e03fd13b-30e3-49c2-928e-3bb066e23a47"],

Cell["Check first that the plot still looks ok.", "Text",ExpressionUUID->"5d485965-6930-40f5-a820-f0275e20bfea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"SamplePts", ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1000"}], "}"}], ",", "Automatic"}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"266714e2-4c98-403f-a079-95260e986ed2"],

