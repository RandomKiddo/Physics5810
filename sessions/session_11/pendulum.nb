   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1000"}], "}"}], ",", "Automatic"}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"85e186c7-91a7-4585-9d2a-b46c61a1b82a"],

