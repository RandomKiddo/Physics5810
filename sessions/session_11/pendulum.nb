Notebook[{

Cell[CellGroupData[{
Cell["Nonlinear Differential Equations: Pendulum", "Subtitle",
 TextAlignment->Center,
 TextJustification->0,ExpressionUUID->"f0afa550-64e2-4586-b22f-e9ffd3746a2f"],

Cell["\<\
In this notebook, we solve nonlinear differential equations, looking at the \
time dependence, phase space plots, Poincare sections, and the power \
spectrum.  

The notebook has specialized to a pendulum equation, with parameters used in \
session 8 of 6810. \
\>", "Text",
 CellChangeTimes->{{3.6037117900814047`*^9, 
  3.60371179056887*^9}},ExpressionUUID->"2f7d511c-c584-4cf0-8614-\
a00ac2e4d3a7"],

Cell[CellGroupData[{

Cell["Define the Differential Equation", "Section",ExpressionUUID->"95841e2d-e4bf-4dbf-b0a4-94fb3810a18f"],

Cell["\<\
Name the equation \"diffeq\".  Note the \"==\" in defining the equation.  \
\>", "Text",ExpressionUUID->"016cb4e5-0465-43a6-a8fa-348eb91f88c5"],

Cell[BoxData[
 RowBox[{"diffeq", " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Theta]", "''"}], "[", "t", "]"}], " ", "+", " ", 
    RowBox[{"\[Alpha]", " ", 
     RowBox[{
      RowBox[{"\[Theta]", "'"}], "[", "t", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"\[Omega]0", "^", "2"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], " ", "\[Equal]", " ", 
   RowBox[{"fext", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"\[Omega]ext", "*", "t"}], " ", "+", " ", "\[Phi]ext"}], 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"ae8e2b47-54e1-455c-b356-339ddbf03fa5"],

Cell["Choose among the parameters:", "Text",ExpressionUUID->"0dec891c-1e83-40ea-9fc1-0c68b43b036d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p1", " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", "0."}], ",", 
     RowBox[{"\[Omega]0", "=", "1"}], ",", 
     RowBox[{"fext", "=", "0."}], ",", 
     RowBox[{"\[Omega]ext", "=", "0.689"}], ",", 
     RowBox[{"\[Phi]ext", "=", " ", "0.0"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"3c8b63af-b818-4871-951f-7a5fa7082b49"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p2", " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", "0.2"}], ",", 
     RowBox[{"\[Omega]0", "=", "1"}], ",", 
     RowBox[{"fext", "=", "0.52"}], ",", 
     RowBox[{"\[Omega]ext", "=", "0.689"}], ",", 
     RowBox[{"\[Phi]ext", "=", " ", "0.0"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[74]:=",ExpressionUUID->"f181375d-d114-4d5b-98c2-ddae2e9abde4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p3", ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", "0.2"}], ",", 
     RowBox[{"\[Omega]0", "=", "1"}], ",", 
     RowBox[{"fext", "=", "0.52"}], ",", 
     RowBox[{"\[Omega]ext", "=", "0.694"}], ",", 
     RowBox[{"\[Phi]ext", "=", "0.0"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"721e61d6-8b09-4748-9563-9299f6ccb1d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p4", ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", "0.2"}], ",", 
     RowBox[{"\[Omega]0", "=", "1"}], ",", 
     RowBox[{"fext", "=", "0.52"}], ",", 
     RowBox[{"\[Omega]ext", "=", "0.689"}], ",", 
     RowBox[{"\[Phi]ext", "=", "0.0"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"77de6367-b4c5-47d0-8bc2-f7a9b360cce2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p5", ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", "0.2"}], ",", 
     RowBox[{"\[Omega]0", "=", "1"}], ",", 
     RowBox[{"fext", "=", "0.9"}], ",", 
     RowBox[{"\[Omega]ext", "=", "0.54"}], ",", 
     RowBox[{"\[Phi]ext", "=", "0.0"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"23179fc1-2537-4605-a0fc-1cb3ffd5cda8"],

Cell[CellGroupData[{

Cell[BoxData["p5"], "Input",
 CellChangeTimes->{{3.982236924203065*^9, 3.9822369243245707`*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"be8d8a73-6044-41e3-bb38-4b76cb14a708"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.2`", ",", "1", ",", "0.9`", ",", "0.54`", ",", "0.`"}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.982236710202195*^9, {3.982236927648079*^9, 3.982236954844987*^9}},
 CellLabel->"Out[78]=",ExpressionUUID->"d5064544-3c15-4e10-99e5-1a7bb90bed59"]
}, Open  ]],

Cell["Choose among the initial conditions:", "Text",ExpressionUUID->"a883d701-e560-496f-bdfc-c477d27ac5ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ic1", " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]0", "=", "0.8"}], ",", 
     RowBox[{"\[Theta]dot0", "=", "0."}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"8b5cbd17-3aa1-47b6-b840-9f589350ff79"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ic2", " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]0", " ", "=", " ", 
      RowBox[{"-", "0.8"}]}], ",", " ", 
     RowBox[{"\[Theta]dot0", " ", "=", " ", "0.1234"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"c6c637ee-75dd-4810-9d64-49782542b6b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ic3", ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]0", "=", "0.8"}], ",", 
     RowBox[{"\[Theta]dot0", "=", "0.8"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[81]:=",ExpressionUUID->"58a5288c-81a0-4d42-8f2b-ecfe79935ff7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ic4", ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]0", "=", "0.8"}], ",", 
     RowBox[{"\[Theta]dot0", "=", "0.8"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[82]:=",ExpressionUUID->"b1b77e97-8475-4960-9c6e-d76b2a2f564e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ic5", ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]0", "=", 
      RowBox[{"-", "0.8"}]}], ",", 
     RowBox[{"\[Theta]dot0", "=", "0.1234"}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"6a9741c6-54e2-4ba4-9072-73ebc03d9711"],

Cell[CellGroupData[{

Cell[BoxData["ic2"], "Input",
 CellLabel->"In[84]:=",ExpressionUUID->"16c7ea3a-767b-4a01-9993-549853433eaa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "0.8`"}], ",", "0.1234`"}], "}"}]], "Output",
 CellChangeTimes->{
  3.982236710221451*^9, {3.982236927658662*^9, 3.982236954857656*^9}},
 CellLabel->"Out[84]=",ExpressionUUID->"ef80472c-4a7b-43f9-8ce3-d5213db95fbc"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solve the Differential Equation", "Section",ExpressionUUID->"d8a9cb09-bbfd-4d12-a7b6-edb2cf90f2e2"],

Cell["\<\
Specify the range in time over which we will solve the differential equation. \
 We won't be able to use the solution outside of this range. (I.e., we'll \
have to extend this range if we get an \"outside of range\" error later.)\
\>", "Text",ExpressionUUID->"8bdf4e6f-7fda-4027-8209-c23da53ef88f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tmin", "=", "0"}], ";", " ", 
  RowBox[{"tmax", "=", "1000"}], ";"}]], "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"a990007e-a877-4cf5-b9a5-080d5d875541"],

Cell["\<\
Numerically solve the differential equaiton using NDSolve, specifying the \
initial conditions.  Setting MaxSteps to a large number is needed if tmax is \
large.\
\>", "Text",ExpressionUUID->"96dab19e-bf5b-4ea3-89b6-b4e1e886eceb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solution", " ", "=", " ", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"diffeq", ",", 
       RowBox[{
        RowBox[{"\[Theta]", "[", "0", "]"}], "\[Equal]", "\[Theta]0"}], ",", 
       " ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "\[Equal]", 
        "\[Theta]dot0"}]}], "}"}], ",", "\[Theta]", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
     RowBox[{"MaxSteps", "\[Rule]", "20000"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"4587043b-abeb-4cda-88f5-bef026f85c6d"],

Cell["\<\
NDSolve returns an \"interpolating function\", which can be evaluated later \
at any time t in tmin < t < tmax.\
\>", "Text",ExpressionUUID->"ab284ae7-b758-48d5-9a65-ab9b0746fa3c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plot the Time Dependence and Phase Space", "Section",ExpressionUUID->"e7ce5a2d-3200-4b35-9e11-e27e3c92342e"],

Cell["\<\
We can just use \"Plot\" with Evaluate and the \"interpolating function\" \
defined by \"solution\".\
\>", "Text",ExpressionUUID->"d75e5750-f81d-42c1-81ff-0f57a2b7585c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"\[Theta]", "[", "t", "]"}], "/.", "solution"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"92512d45-3957-4445-a75f-7a013a37e6ff"],

