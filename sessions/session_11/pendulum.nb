Cell[CellGroupData[{

Cell["Poincare Sections", "Section",ExpressionUUID->"af911309-a076-42d6-a4ce-25bb30a2d00d"],

Cell["\<\
The idea of a Poincare section is to plot a point in phase space once every \
period of the external force, 2\[Pi]/(external frequency).  The resulting \
pattern gives information about the periodicity of the signal (or indicates \
chaos).  Start the plot at a large enough time t (\"tstart\") so that the \
transients have died out.\
\>", "Text",ExpressionUUID->"9dae6e00-5d03-466b-8e2e-2cd5507fde7b"],

Cell["\<\
Set the external period and how many periods we'll consider.  Define a \
function timeperiod[i] giving the corresponding time as a function of the \
period number.\
\>", "Text",ExpressionUUID->"d0703ad5-0a9d-43ed-80c1-1a90889da731"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Texternal", " ", ":=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Pi", "/", "\[Omega]ext"}]}]}], ";"}]], "Input",
 CellLabel->"In[91]:=",ExpressionUUID->"7a6c50e4-8d03-42a0-bd94-fdf8506b61da"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tstart", " ", "=", " ", 
   RowBox[{"10", "*", "Texternal"}]}], ";"}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"36af59c4-aa47-4f31-a212-490f4f99d86a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numperiods", " ", "=", " ", "20"}], ";"}]], "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"2de2b76e-5569-4e6c-b746-36c129f5e96d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"timeperiod", "[", "i_", "]"}], " ", ":=", " ", 
  RowBox[{"tstart", " ", "+", " ", 
   RowBox[{"i", "*", "Texternal"}]}]}]], "Input",
 CellLabel->"In[94]:=",ExpressionUUID->"2d944119-3e65-49d2-9414-84e4bc0b4d88"],

Cell["\<\
Just evaluate at the relevant points.  Flatten[expr,1] strips off a layer of \
{}'s.\
\>", "Text",ExpressionUUID->"e6601234-f871-4154-996c-72a026c44808"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PoincarePts", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Theta]", "[", 
            RowBox[{"timeperiod", "[", "i", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"\[Theta]", "'"}], "[", 
            RowBox[{"timeperiod", "[", "i", "]"}], "]"}]}], "}"}], "/.", 
         "solution"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "numperiods"}], "}"}]}], "]"}], ",", 
     "1"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[95]:=",ExpressionUUID->"1959c7d1-169d-4c1f-bd7f-2233231f280e"],

Cell["ListPlot plots pairs of numbers in the PlotRange.", "Text",ExpressionUUID->"60d9983f-4363-4c23-8b69-7cee748d236c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{"PoincarePts", ",", 
   RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
   RowBox[{"BaseStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
      RowBox[{"FontSize", "\[Rule]", "14"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"300", ",", "300"}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Style", "[", "\"\<Poincare Section\>\"", "]"}]}], ",", 
   RowBox[{"AxesOrigin", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
