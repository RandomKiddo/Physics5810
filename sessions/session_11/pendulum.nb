Cell[CellGroupData[{

Cell["Power Spectrum", "Section",ExpressionUUID->"54e13c63-1c06-41ec-b1a8-01b103112fd6"],

Cell["\<\
The power spectrum is found by taking a Fourier transform (FFT) of the \
signal.  We generate points at the same time intervals as in \
diffeq_pendulum.cpp.\
\>", "Text",ExpressionUUID->"fe1a28da-4404-4c0b-98e8-cc94435a8b82"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tskip", " ", "=", " ", "100"}], ";"}]], "Input",
 CellLabel->"In[97]:=",ExpressionUUID->"a1992d0b-a651-44ee-af05-671952d5122d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"time", "[", "i_", "]"}], ":=", 
  RowBox[{"tstart", "+", 
   RowBox[{"i", "*", 
    RowBox[{"Texternal", "/", "Tskip"}]}]}]}]], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"2ae51375-bcbe-4745-b60e-b872871aab51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numpoints", " ", "=", " ", "5000"}], ";"}]], "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"3b263c46-de3d-45b9-b41f-a8dda6e1b9f2"],

Cell[BoxData[
 RowBox[{"SampleTime", " ", ":=", " ", 
  RowBox[{"numpoints", " ", "*", " ", 
   RowBox[{"Texternal", "/", "Tskip"}]}]}]], "Input",
 CellLabel->
  "In[100]:=",ExpressionUUID->"404d8494-ed56-4d50-9a7b-3f621ce4c745"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SamplePts", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"time", "[", "i", "]"}], "]"}], "/.", "solution"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "numpoints"}], "}"}]}], "]"}], ",", "1"}],
     "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"318be0c6-3796-40c5-a230-fdd9f0990bc4"],

Cell["Check first that the plot still looks ok.", "Text",ExpressionUUID->"0d3c1ca4-afab-46a6-af66-f653d8fc8712"],

Cell[CellGroupData[{

Cell[BoxData[
