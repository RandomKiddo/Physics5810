Cell["\<\
The basic command is Fourier.  FourierParameters chooses a particular \
conention for defining the transform.  Abs takes the magnitude of the \
resulting complex number (which we then square).  \
\>", "Text",ExpressionUUID->"2467a296-58c7-403c-9eea-78a46c050622"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transform", " ", "=", " ", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"Fourier", "[", 
      RowBox[{"SamplePts", ",", 
       RowBox[{"FourierParameters", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}], "]"}], "^", 
    "2"}]}], ";"}]], "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"69290c13-6f47-4326-ac48-453b03a8646e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"frequencies", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"Pi", "/", "SampleTime"}]}], ")"}], "*", "i"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "numpoints"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[104]:=",ExpressionUUID->"bc02de07-6b31-4df6-b9f8-2457ff711665"],

Cell["\<\
Transpose to make pairs of points from two separate lists of points.\
\>", "Text",ExpressionUUID->"0dd6bd58-7578-4757-93b0-731629bdaba7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PlotPts", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"frequencies", ",", "transform"}], "}"}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[105]:=",ExpressionUUID->"6af58a2a-fd93-4b54-b678-8129cecff785"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLogPlot", "[", 
  RowBox[{"PlotPts", ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.001`", ",", "2"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"BaseStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}], ",", 
      RowBox[{"FontSize", "\[Rule]", "14"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"400", ",", "400"}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"Style", "[", "\"\<Power Spectrum\>\"", "]"}]}], ",", 
   RowBox[{"AxesOrigin", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<freq.\>\"", ",", "\"\<power\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"1f42cec2-ff4a-4616-879f-76f6c876e2aa"],

