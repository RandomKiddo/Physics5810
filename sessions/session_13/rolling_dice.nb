Cell["Let's define a function that combines all of these steps:", "Text",ExpressionUUID->"517c7585-9b43-468c-917b-4ff260f8a439"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Rolldice", "[", "trials_", "]"}], " ", ":=", " ", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dots", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}], 
      "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"dice", " ", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "6"}], "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"toss", " ", "=", " ", 
     RowBox[{"RandomInteger", "[", 
      RowBox[{"dice", ",", "trials"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"freq", "=", 
     RowBox[{"BinCounts", "[", 
      RowBox[{"toss", ",", 
       RowBox[{"{", 
        RowBox[{".5", ",", "6.5", ",", "1"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"avgdots", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{"(", 
         RowBox[{"freq", "*", "dots"}], ")"}]}], "/", "trials"}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"avgdotssq", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Plus", "@@", 
        RowBox[{"(", 
         RowBox[{"freq", "*", 
          RowBox[{"dots", "^", "2"}]}], ")"}]}], "/", "trials"}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"sdev", " ", "=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"avgdotssq", "-", 
       RowBox[{"avgdots", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<mean = \>\"", ",", "avgdots", 
      ",", "\"\<  standard deviation = \>\"", ",", "sdev"}], "]"}], ";", 
