Cell[CellGroupData[{

Cell["Simulate the dice!", "Section",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"9174bb9a-2461-4dad-a55e-0da7e6e1ae4f"],

Cell["Possible outcomes of throwing a single die:", "Text",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"db14db55-d008-4cb0-9ad4-24185108279b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dots", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}], 
   "}"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"2ea34d00-c224-4d13-a4b8-afccf873dc4a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.464605508599*^9, 3.464605579879552*^9, 
  3.984052429587118*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"9e0cb6de-2907-41fe-ac26-e4534394c2a3"]
}, Open  ]],

Cell["\<\
We define a uniform probability distribution for the results 1 to 6, and call \
it \"dice\":\
\>", "Text",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"71fcdf08-d842-41b0-a5af-c66b60ca46ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dice", " ", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "6"}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.443949332253569*^9, 3.443949332397006*^9}, {
  3.443949716401824*^9, 3.443949719385013*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"0d9f49dc-96b2-4d6b-bc2d-2a8c62dba6c6"],

Cell["How many times we toss the die => trials:", "Text",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"9ee09319-1a72-4b40-b34d-4a3d7f66178f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trials", " ", "=", " ", "120"}], ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"b7c93cf2-578f-48b8-89ce-101e56ae7d88"],

Cell["Toss it (suppressing output with a ; when trials is large):", "Text",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"7a5246a3-e51e-4611-a150-47dfa87fe782"],

Cell[BoxData[
 RowBox[{
  RowBox[{"toss", " ", "=", " ", 
   RowBox[{"RandomInteger", "[", 
    RowBox[{"dice", ",", "trials"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.443949389367591*^9, 3.443949397958453*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"a27b92d9-cfe6-405d-9a24-86ea8ccd0e3d"],

