Cell[CellGroupData[{
Cell[TextData[StyleBox["Throwing Dice",
 FontSize->24,
 FontWeight->"Bold"]], "Title",
 TextAlignment->Center,
 TextJustification->0,
 FontSize->18,ExpressionUUID->"02cb9c4f-9483-447b-9737-77d405cff80e"],

Cell["In this notebook, we'll simulate the rolling of dice.", "Text",ExpressionUUID->"1dde2ac9-0d62-4255-b6bb-3bd22b05f6f5"],

Cell[CellGroupData[{

Cell["Clear symbols", "Section",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"c87c6c86-1320-4253-ad52-7cadac016231"],

Cell["\<\
In order to avoid interference from symbols defined in other notebooks, we \
first Clear and Remove all symbols.  We assume that the relevant symbols are \
in the Global` context.\
\>", "Text",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"45882281-64bd-4656-803b-aed09e04389a"],

Cell["Clear[\"Global`*\"]", "Input",
 AspectRatioFixed->True,
 CellLabel->"In[2]:=",ExpressionUUID->"7881f29e-f9e3-4150-adee-e6a22196336f"],

Cell["Remove[\"Global`*\"]", "Input",
 AspectRatioFixed->True,
 CellLabel->"In[3]:=",ExpressionUUID->"057771cd-8c7d-4fd2-8a16-9b806aef2e28"]
}, Open  ]],

