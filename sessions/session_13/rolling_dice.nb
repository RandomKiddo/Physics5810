Cell["Calculate the average value of the number of dots:", "Text",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"452c837a-29d9-4ac6-a383-1f540e9a4516"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", " ", 
  RowBox[{
   RowBox[{"Plus", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{"freq", "*", "dots"}], ")"}]}], " ", "/", " ", "trials"}], " ", 
  "]"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"e47038a1-941b-4fc8-85d2-10ef4cf6d920"],

